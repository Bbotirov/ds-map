{
  "name": "ds-map",
  "version": "0.2.0",
  "description": "Живая карта работы агента рядом с чатом — вдохновлено lot-map (MIT)",
  "bin": {
    "dsmap": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p extension --noEmit",
    "lint": "eslint src test extension/src scripts/copy-ui.mjs scripts/package-extension.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "doctor": "node dist/cli.js doctor",
    "package:extension": "node scripts/package-extension.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.146.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/vsce": "^4.1.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "build": {
    "appId": "dev.dsmap.app",
    "productName": "ds-map",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
